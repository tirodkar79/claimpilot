NODE_ENV=development
PORT=3000

MONGO_URI=mongodb://localhost:27017/claimpilot

# role:key pairs, comma separated. Sent as the x-api-key header.
API_KEYS=claimant:dev-claimant-key,reviewer:dev-reviewer-key

# Outbound HTTP defaults (per-client overrides allowed)
HTTP_TIMEOUT_MS=8000
HTTP_MAX_RETRIES=2

# Comma-separated origins allowed by CORS (the web app)
CORS_ORIGINS=http://localhost:5173

# Language model: provider:model-id. Providers: google, groq, ollama.
MODEL=google:gemini-3.5-flash-lite
# Optional: used when MODEL hits its quota or is overloaded (free quotas are per model). Same format.
# MODEL_FALLBACK=google:gemini-3.1-flash-lite
GOOGLE_GENERATIVE_AI_API_KEY=
# GROQ_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/api
# Pace all model calls under the free-tier quota (Gemini Flash-Lite: 15/min). 0 = no limit.
MODEL_REQUESTS_PER_MINUTE=14

# Time zone for "today" and claim dates.
CLAIMANT_TIMEZONE=Asia/Kolkata

# Flight data: fixtures (recorded, default) or live (AeroDataBox via RapidAPI, needs a key).
FLIGHT_DATA_MODE=fixtures
# AERODATABOX_API_KEY=

# Weather evidence: external Open-Meteo MCP server (stdio, no key).
OPEN_METEO_MCP_COMMAND=npx -y open-meteo-mcp-server
WEATHER_TIMEOUT_MS=20000

# Demo/evals only: lets POST /claims take an x-inject-failure header (e.g. "weather") to make that step fail.
ALLOW_FAILURE_INJECTION=false
