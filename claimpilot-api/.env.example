NODE_ENV=development
PORT=3000

MONGO_URI=mongodb://localhost:27017/claimpilot

# role:key pairs, comma separated. Sent as the x-api-key header.
API_KEYS=claimant:dev-claimant-key,reviewer:dev-reviewer-key

# Outbound HTTP defaults (per-client overrides allowed)
HTTP_TIMEOUT_MS=8000
HTTP_MAX_RETRIES=2

# Comma-separated origins allowed by CORS (the web app)
CORS_ORIGINS=http://localhost:5173

# Language model: provider:model-id. Providers: google, groq, ollama.
MODEL=google:gemini-3.5-flash-lite
GOOGLE_GENERATIVE_AI_API_KEY=

# Time zone for "today" and claim dates.
CLAIMANT_TIMEZONE=Asia/Kolkata

# Flight data: fixtures (recorded, default) or live (AeroDataBox via RapidAPI, needs a key).
FLIGHT_DATA_MODE=fixtures
# AERODATABOX_API_KEY=
