{
    "name": "claimpilot-api",
    "version": "0.1.0",
    "private": true,
    "description": "ClaimPilot API: multi-agent flight-delay claim triage",
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:prod": "node dist/main",
        "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
        "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
        "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
        "lint": "eslint \"{src,test}/**/*.ts\" --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "lint:check": "eslint \"{src,test}/**/*.ts\""
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.ts$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.ts",
            "!main.ts",
            "!**/*.module.ts"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "dependencies": {
        "@ai-sdk/google": "^4.0.87",
        "@ai-sdk/groq": "^4.0.54",
        "@mastra/core": "^1.74.0",
        "@nestjs/common": "^12.1.2",
        "@nestjs/config": "^12.0.1",
        "@nestjs/core": "^12.1.2",
        "@nestjs/mongoose": "^12.0.0",
        "@nestjs/platform-express": "^12.1.2",
        "@nestjs/swagger": "^12.0.2",
        "axios": "^1.20.0",
        "mongoose": "^9.10.3",
        "ollama-ai-provider-v2": "^4.0.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@nestjs/cli": "^12.0.8",
        "@nestjs/schematics": "^12.0.6",
        "@nestjs/testing": "^12.1.2",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.3",
        "@types/supertest": "^7.2.1",
        "ai": "^7.0.127",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.13.0",
        "jest": "^30.5.2",
        "mongodb-memory-server": "^11.3.0",
        "prettier": "^3.9.9",
        "supertest": "^7.3.0",
        "ts-jest": "^29.4.14",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0"
    },
    "engines": {
        "node": ">=24"
    }
}
